# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://verifier:verifier@localhost:5432/verifier

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# F5 BIG-IP (not yet implemented)
F5_HOST=
F5_USERNAME=
F5_PASSWORD=
F5_VERIFY_TLS=true

# CrowdStrike (not yet implemented)
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_WEBHOOK_SECRET=

# API auth
API_KEY_HEADER=X-Api-Key
API_KEY=change-me

# Callback
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=3
