{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/f5-exposure-verifier/common_event_envelope",
  "title": "CommonEventEnvelope",
  "description": "Common envelope for all events.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "source",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}