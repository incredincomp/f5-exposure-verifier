{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/f5-exposure-verifier/verify_request",
  "title": "VerifyRequest",
  "description": "Inbound exposure verification request.",
  "type": "object",
  "required": [
    "request_id",
    "source",
    "target",
    "submitted_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "callback_url": {
      "type": "string",
      "format": "uri"
    },
    "metadata": {
      "type": "object"
    },
    "target": {
      "type": "object",
      "required": [
        "ip_address"
      ],
      "properties": {
        "ip_address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostname": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}